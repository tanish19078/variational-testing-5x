# =============================================================================
#  Copy to `.env` and fill in. `.env` is gitignored - never commit it.
# =============================================================================

# -----------------------------------------------------------------------------
#  BACKEND SELECTION
#
#  VR_BASE_URL points the client at whichever backend you are testing against.
#
#    http://127.0.0.1:8787   -> the bundled local mock (default; see mock/).
#                               No auth, no funds, safe to hammer.
#    https://omni.variational.io  -> the real venue. There is currently NO
#                               public programmatic order API; this is here so
#                               the base URL is a one-line swap once Variational
#                               ships and documents it.
# -----------------------------------------------------------------------------
VR_BASE_URL="http://127.0.0.1:8787"

# Sent as the `vr-connected-address` header. For the mock, any value works.
VR_CONNECTED_ADDRESS="0x0000000000000000000000000000000000000000"

# Session cookie. Ignored by the mock; required by a real backend.
VR_COOKIE=""


# -----------------------------------------------------------------------------
#  SAFETY
# -----------------------------------------------------------------------------
# true  -> log every intended action, send no order-mutating request.
# false -> place and cancel orders for real against VR_BASE_URL.
DRY_RUN=true


# -----------------------------------------------------------------------------
#  INSTRUMENT
#
#  Instrument id is P-<UNDERLYING>-<SETTLEMENT_ASSET>-<FUNDING_INTERVAL_S>,
#  e.g. P-TRUMP-USDC-3600.
# -----------------------------------------------------------------------------
UNDERLYING=TRUMP
SETTLEMENT_ASSET=USDC
FUNDING_INTERVAL_S=3600


# -----------------------------------------------------------------------------
#  RANGE BOT STRATEGY
# -----------------------------------------------------------------------------
# Half-width of the quoting range, in percent either side of mark.
RANGE_PCT=1.5

# Size of each resting limit order, in contracts (base units).
ORDER_SIZE=1

# Seconds between strategy iterations.
POLL_INTERVAL_S=10

# Re-quote only when an existing order drifts more than this % from its target.
# Prevents cancel/replace churn on every tick.
REQUOTE_TOLERANCE_PCT=0.25

# Per-order slippage guard sent as `slippage_limit`.
MAX_SLIPPAGE=0.005


# -----------------------------------------------------------------------------
#  RISK ENGINE
# -----------------------------------------------------------------------------
# Hard cap on absolute net position size. Breaching it halts new entries.
MAX_POSITION_SIZE=10

# Consecutive 5xx/401 responses before the kill switch trips, cancelling all
# orders and stopping the bot.
KILL_SWITCH_THRESHOLD=3

# Per-request HTTP timeout (seconds) and retry budget for 429/5xx.
TIMEOUT_S=8
MAX_RETRIES=3


# -----------------------------------------------------------------------------
#  LIVE READ-ONLY MONITOR (optional)
#
#  The public stats endpoint is genuinely unauthenticated and returns live
#  mark/bid/ask. Used by monitor.py. Safe, read-only, no session required.
# -----------------------------------------------------------------------------
STATS_URL="https://omni-client-api.prod.ap-northeast-1.variational.io/metadata/stats"
